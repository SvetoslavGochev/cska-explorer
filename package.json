{
  "name": "cska-site",
  "version": "1.0.0",
  "private": true,
  "description": "CSKA and Bulgarian football info site with cached data",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/today-matches.test.js && node tests/data-api.test.js && node tests/squad-refresh.test.js",
    "test:live": "node tests/today-matches.test.js --live",
    "ops:refresh": "node scripts/refresh-player-stats.js",
    "ops:refresh-squad": "node scripts/refresh-player-stats.js --if-due",
    "ops:verify:local": "node scripts/verify-local.js",
    "ops:verify:live": "node scripts/verify-live.js",
    "ops:persist-standings": "node scripts/persist-live-standings.js",
    "ops:refresh-and-push": "node scripts/refresh-and-push.js"
  },
  "dependencies": {}
}
